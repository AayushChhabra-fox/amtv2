# ---------- Databricks auth: pick ONE method ----------
DATABRICKS_HOST=https://fox-product-eng-dev-nation.cloud.databricks.com
# 1) Personal access token (dev)
DATABRICKS_TOKEN=
# 2) Service principal OAuth M2M (unattended runs; preferred)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# 3) CLI profile from ~/.databrickscfg (leave token/client fields blank)
DATABRICKS_CONFIG_PROFILE=
# Legacy aliases still read: dbx_host, dbx_token

# ---------- Workspace target ----------
AMT_BUNDLE_TARGET=dev
AMT_CATALOG=product_api_dev
AMT_SCHEMA=amt
AMT_ARTIFACT_VOLUME=/Volumes/product_api_dev/amt/amt_artifacts
AMT_MLFLOW_EXPERIMENT_ROOT=/Shared/amt

# ---------- Compute ----------
# Set to run EVERY job (build, round 0, ladder, search, confirm, final) on one cluster.
# Blank = per-job clusters from resources/*.job.yml.
AMT_CLUSTER_ID=
AMT_CLUSTER_AUTOSTART=true
# Used for candidates with device: gpu. Blank = job cluster on AMT_GPU_NODE_TYPE; both blank = no GPU families.
AMT_GPU_CLUSTER_ID=
AMT_GPU_NODE_TYPE=
# Job-cluster mode only
AMT_NODE_TYPE=m5d.xlarge
AMT_SPARK_VERSION=15.4.x-scala2.12

# ---------- Run limits (never loosen a brief) ----------
AMT_MAX_CONCURRENT_JOBS=2
AMT_DBU_PER_HOUR=
AMT_GPU_DBU_PER_HOUR=
AMT_JOB_WAIT_TIMEOUT_S=16200

# ---------- Agents ----------
AMT_AGENT_BACKEND=cursor
CURSOR_API_KEY=
AMT_MODEL_PLANNER=
AMT_MODEL_CRITIC=
AMT_MODEL_IMPLEMENTER=
AMT_MODEL_REVIEWER=
AMT_AGENT_TIMEOUT_S=600
AMT_TOKEN_CAP=32000

# ---------- Testing only ----------
# AMT_JOBS_BACKEND=fake
